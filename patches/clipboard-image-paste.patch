         co_await winrt::resume_background();
 
         winrt::hstring text;
+        wil::com_ptr<IWICBitmap> image;
         if (const auto clipboard = clipboard::open(nullptr))
         {
             text = clipboard::read();
+            // Keep text and Explorer file paste unchanged. Windows synthesizes
+            // CF_BITMAP from CF_DIB/CF_DIBV5 used by PrintScreen and Snipping Tool.
+            if (text.empty())
+            {
+                if (const auto bitmap = GetClipboardData(CF_BITMAP))
+                {
+                    image = clipboard::copyBitmap(static_cast<HBITMAP>(bitmap), static_cast<HPALETTE>(GetClipboardData(CF_PALETTE)));
+                }
+            }
+        }
+        if (image)
+        {
+            // Use the existing file-path paste contract, including bracketed
+            // paste and warnings. Do not rewrite the user's clipboard.
+            text = winrt::hstring{ clipboard::saveTemporaryPng(image.get()) };
         }
 
         if (!bracketedPaste && globalSettings.TrimPaste())
