diff --git a/src/cascadia/TerminalApp/ClipboardFiles.h b/src/cascadia/TerminalApp/ClipboardFiles.h
--- a/src/cascadia/TerminalApp/ClipboardFiles.h
+++ b/src/cascadia/TerminalApp/ClipboardFiles.h
@@ -7,10 +7,32 @@
 #include <shellapi.h>
 #include <wil/result.h>
 #include <string>
+#include <string_view>
 #include <vector>
 
 namespace clipboard
 {
+    inline std::wstring quotePath(const std::wstring_view path)
+    {
+        std::wstring text{ L"\"" };
+        text.append(path);
+        text.push_back(L'"');
+        return text;
+    }
+
+    // Each destination negotiates bracketed paste independently.
+    inline std::wstring framePaste(const std::wstring_view text, const bool bracketed)
+    {
+        if (!bracketed)
+        {
+            return std::wstring{ text };
+        }
+        std::wstring framed{ L"\x1b[200~" };
+        framed.append(text);
+        framed.append(L"\x1b[201~");
+        return framed;
+    }
+
     // Snapshot every Explorer file while the clipboard is open. Each string is
     // a separate paste: Codex recognizes one image path per bracketed paste.
     // Windows paths remain Windows paths, as in the existing single-file paste.
@@ -31,9 +53,8 @@
             // Explorer paths cannot contain these. Refuse malformed clipboard
             // payloads rather than putting control sequences into terminal input.
             THROW_HR_IF(E_INVALIDARG, path.find_first_of(L"\"\r\n\x1b") != std::wstring::npos);
-            auto& paste = pastes.emplace_back(index ? L" \"" : L"\"");
-            paste.append(path);
-            paste.push_back(L'"');
+            auto& paste = pastes.emplace_back(index ? L" " : L"");
+            paste.append(quotePath(path));
         }
         return pastes;
     }
