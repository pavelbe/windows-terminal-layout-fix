 using namespace TerminalCoreUnitTests;
 
+void TerminalApiTest::TabColorSurvivesUnchangedSettings()
+{
+    Terminal term{ Terminal::TestDummyMarker{} };
+    DummyRenderer renderer{ &term };
+    term.Create({ 100, 100 }, 0, renderer);
+    auto settings = winrt::make<MockTermSettings>(100, 100, 100);
+    term.UpdateSettings(settings);
+
+    term._stateMachine->ProcessString(L"\x1b]4;264;#ff5722\x1b\\");
+    const auto runtimeColor = term.GetTabColor();
+    VERIFY_IS_TRUE(runtimeColor.has_value());
+    term.UpdateSettings(settings);
+    VERIFY_IS_TRUE(term.GetTabColor() == runtimeColor);
+
+    // An unchanged reload must not make the runtime override the reset default.
+    term._stateMachine->ProcessString(L"\x1b]104;264\x1b\\");
+    VERIFY_IS_FALSE(term.GetTabColor().has_value());
+}
+
+void TerminalApiTest::TabColorSettingsChangesAndReset()
+{
+    Terminal term{ Terminal::TestDummyMarker{} };
+    DummyRenderer renderer{ &term };
+    term.Create({ 100, 100 }, 0, renderer);
+    auto mock = winrt::make_self<MockTermSettings>(100, 100, 100);
+    const auto settings = mock.as<ICoreSettings>();
+    const winrt::Microsoft::Terminal::Core::Color blue{ 0, 0, 255, 255 };
+    mock->TabColor(winrt::box_value(blue).as<winrt::Windows::Foundation::IReference<winrt::Microsoft::Terminal::Core::Color>>());
+    term.UpdateSettings(settings);
+    const auto profileColor = term.GetTabColor();
+    VERIFY_IS_TRUE(profileColor.has_value());
+    term._stateMachine->ProcessString(L"\x1b]4;264;#ff5722\x1b\\");
+    const auto runtimeColor = term.GetTabColor();
+    VERIFY_IS_TRUE(runtimeColor != profileColor);
+    term.UpdateSettings(settings);
+    VERIFY_IS_TRUE(term.GetTabColor() == runtimeColor);
+    term._stateMachine->ProcessString(L"\x1b]104;264\x1b\\");
+    VERIFY_IS_TRUE(term.GetTabColor() == profileColor);
+
+    term._stateMachine->ProcessString(L"\x1b]4;264;#ff5722\x1b\\");
+    mock->TabColor(nullptr);
+    term.UpdateSettings(settings);
+    VERIFY_IS_FALSE(term.GetTabColor().has_value());
+    mock->TabColor(winrt::box_value(blue).as<winrt::Windows::Foundation::IReference<winrt::Microsoft::Terminal::Core::Color>>());
+    term.UpdateSettings(settings);
+    VERIFY_IS_TRUE(term.GetTabColor() == profileColor);
+
+    mock->StartingTabColor(winrt::box_value(blue).as<winrt::Windows::Foundation::IReference<winrt::Microsoft::Terminal::Core::Color>>());
+    term.UpdateSettings(settings);
+    term._stateMachine->ProcessString(L"\x1b]4;264;#ff5722\x1b\\");
+    mock->TabColor(nullptr);
+    term.UpdateSettings(settings);
+    VERIFY_IS_TRUE(term.GetTabColor() == profileColor);
+}
