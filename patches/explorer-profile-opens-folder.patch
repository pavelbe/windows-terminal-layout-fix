     // Method Description:
     // - This method creates a flyout menu item for a given profile with the given index.
     //   It makes sure to set the correct icon, keybinding, and click-action.
+    // A profile whose command is explorer.exe is a utility: it opens a folder
+    // instead of starting a pane. No argument opens this Terminal's own folder;
+    // an argument opens that target, for example shell:MyComputerFolder.
+    static std::optional<std::wstring> _ExplorerTarget(const winrt::hstring& commandline)
+    {
+        std::wstring command{ commandline };
+        const auto first = command.find_first_not_of(L" \t");
+        if (first == std::wstring::npos)
+        {
+            return std::nullopt;
+        }
+        command.erase(0, first);
+        const auto space = command.find_first_of(L" \t");
+        const auto exe = command.substr(0, space);
+        if (_wcsicmp(exe.c_str(), L"explorer.exe") != 0 && _wcsicmp(exe.c_str(), L"explorer") != 0)
+        {
+            return std::nullopt;
+        }
+        if (space == std::wstring::npos)
+        {
+            return std::wstring{};
+        }
+        auto target = command.substr(space + 1);
+        const auto begin = target.find_first_not_of(L" \t");
+        if (begin == std::wstring::npos)
+        {
+            return std::wstring{};
+        }
+        target.erase(0, begin);
+        while (!target.empty() && (target.back() == L' ' || target.back() == L'\t'))
+        {
+            target.pop_back();
+        }
+        if (target.size() >= 2 && target.front() == L'"' && target.back() == L'"')
+        {
+            target = target.substr(1, target.size() - 2);
+        }
+        return target;
+    }
