--- /dev/null
+++ b/src/cascadia/TerminalApp/ClipboardFiles.h
@@ -0,0 +1,40 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+
+#pragma once
+
+#include <Windows.h>
+#include <shellapi.h>
+#include <wil/result.h>
+#include <string>
+#include <vector>
+
+namespace clipboard
+{
+    // Snapshot every Explorer file while the clipboard is open. Each string is
+    // a separate paste: Codex recognizes one image path per bracketed paste.
+    // Windows paths remain Windows paths, as in the existing single-file paste.
+    // The leading spaces also make the result usable as a list of shell words.
+    inline std::vector<std::wstring> readFilePastes(HDROP drop)
+    {
+        std::vector<std::wstring> pastes;
+        const auto count = DragQueryFileW(drop, 0xffffffff, nullptr, 0);
+        THROW_HR_IF(E_INVALIDARG, count > 256);
+        pastes.reserve(count);
+        for (UINT index = 0; index < count; ++index)
+        {
+            const auto length = DragQueryFileW(drop, index, nullptr, 0);
+            THROW_HR_IF(E_INVALIDARG, length == 0 || length > 32767);
+            std::wstring path(length + 1, L'\0');
+            THROW_HR_IF(E_INVALIDARG, DragQueryFileW(drop, index, path.data(), length + 1) != length);
+            path.resize(length);
+            // Explorer paths cannot contain these. Refuse malformed clipboard
+            // payloads rather than putting control sequences into terminal input.
+            THROW_HR_IF(E_INVALIDARG, path.find_first_of(L"\"\r\n\x1b") != std::wstring::npos);
+            auto& paste = pastes.emplace_back(index ? L" \"" : L"\"");
+            paste.append(path);
+            paste.push_back(L'"');
+        }
+        return pastes;
+    }
+}
