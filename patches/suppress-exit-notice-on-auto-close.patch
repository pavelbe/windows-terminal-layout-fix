+    // Method Description:
+    // - Records whether the owning pane will close by itself after this exit.
+    //   The "process exited" notice is skipped in that case, because otherwise
+    //   it is written into the buffer and stays visible until the asynchronous
+    //   pane close completes.
+    // Arguments:
+    // - suppressOnClosed: the pane closes after a successful/handled exit.
+    // - suppressOnFailed: the pane closes after a failed exit.
+    void ConptyConnection::SetExitNoticeSuppression(const bool suppressOnClosed, const bool suppressOnFailed) noexcept
+    {
+        _suppressExitNoticeOnClosed.store(suppressOnClosed, std::memory_order_relaxed);
+        _suppressExitNoticeOnFailed.store(suppressOnFailed, std::memory_order_relaxed);
+    }
+
     // Method Description:
     // - prints out the "process exited" message formatted with the exit code
     // Arguments:
@@ -613,8 +627,14 @@ namespace winrt::Microsoft::Terminal::TerminalConnection::implementation
         // Signal the closing or failure of the process.
         // exitCode might be STILL_ACTIVE if a client has called FreeConsole() and
         // thus caused the tab to close, even though the CLI app is still running.
-        _transitionToState(exitCode == 0 || exitCode == STILL_ACTIVE ? ConnectionState::Closed : ConnectionState::Failed);
-        _indicateExitWithStatus(exitCode);
+        const auto closed = exitCode == 0 || exitCode == STILL_ACTIVE;
+        _transitionToState(closed ? ConnectionState::Closed : ConnectionState::Failed);
+        const auto suppressNotice = closed ? _suppressExitNoticeOnClosed.load(std::memory_order_relaxed)
+                                           : _suppressExitNoticeOnFailed.load(std::memory_order_relaxed);
+        if (!suppressNotice)
+        {
+            _indicateExitWithStatus(exitCode);
+        }
