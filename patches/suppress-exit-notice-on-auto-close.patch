+
+    // Method Description:
+    // - Mirrors the closeOnExit decision into the connection. When this pane will
+    //   close by itself, the connection skips the "process exited" notice so the
+    //   text cannot flash between the exit and the asynchronous pane removal.
+    void TerminalPaneContent::_applyExitNoticePolicy()
+    {
+        if (!_profile)
+        {
+            return;
+        }
+
+        const auto mode = _profile.CloseOnExit();
+        const auto suppressOnClosed = mode != CloseOnExitMode::Never;
+        const auto suppressOnFailed = mode == CloseOnExitMode::Always || (mode == CloseOnExitMode::Automatic && _isDefTermSession);
+
+        const auto connection{ _control.Connection() };
+        if (!connection)
+        {
+            return;
+        }
+
+        if (const auto conpty{ connection.try_as<ConptyConnection>() })
+        {
+            conpty.SetExitNoticeSuppression(suppressOnClosed, suppressOnFailed);
+        }
     }
 
